PORT=3001
HOST=127.0.0.1
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
STORAGE_BUCKET=videos-staging

CORS_ORIGINS=http://localhost:5173
MEDIA_MAX_BYTES=50000000
MEDIA_MAX_DURATION_SECONDS=90
FRONTEND_URL=http://localhost:5173
MEDIA_UPLOAD_ENABLED=false
MEDIA_PROCESSOR_MODE=inline-original

MEDIA_TRIMMING_ENABLED=false

# Opt-in only after migration and runtime validation; needs the pinned binary at build time.
MEDIA_TIKTOK_IMPORT_ENABLED=false

# Experimental local choice only; no automatic fallback after HTTP 403.
MEDIA_TIKTOK_DOWNLOAD_MODE=range

# Piloto TikTok: trecho <=30s, fonte <=50000000 bytes; upload independente mantém seu limite.
# temporary continua opt-in; habilitar somente no ambiente de teste autorizado.
